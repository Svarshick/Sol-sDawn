<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6.1">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../SolsDawn.Engine/SolsDawn.Engine.csproj" />
    <ProjectReference Include="../SolsDawn.Analyzers/SolsDawn.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    
    <Using Include="Microsoft.Xna.Framework.Color" Alias="Color" />
    <Using Include="Microsoft.Xna.Framework.Vector2" Alias="Vector2" />
    <Using Include="Microsoft.Xna.Framework.MathHelper" Alias="MathHelper" />
    
    <Using Include="nkast.Aether.Physics2D.Collision.Shapes.Shape" Alias="Shape" />

    <Using Include="SolsDawn.Kernel.Component" Alias="Component" />
    <Using Include="SolsDawn.Kernel.GameObject" Alias="GameObject" />
    <Using Include="SolsDawn.Kernel.Transform2" Alias="Transform2" />

    <Using Include="SolsDawn.Engine" />
    <Using Include="SolsDawn.Engine.GameplayAPI" Static="true" />
    <Using Include="SolsDawn.Gameplay.Main" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="_Data\" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Update="_Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
