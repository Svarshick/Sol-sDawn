---------------------------------------------------------
	Spear attack	
---------------------------------------------------------
+animation
+pb1
+pb2
+pb3
+atkEndT1
+atkEndT2
+atkEndT3
+atk

atk.Start; pb1.Open; animation.Play
r1(atkEndT1, pb1.End) -> (pb1.Close)
r1 1.[atkEndT1] (atk.End; animation.Stop)
r1 2.[pb1.End] ("change animation"; pb2.Open;) -> atkEndT2; r2(atkEndT2, pb2.End)
 r2 1.[atkEndT1] (atk.End; animation.Stop)
 r2 2.[pb2.End] ("change animation"; pb3.Open;) -> atkEndT3; r3(atkEndT3, pb3.End) ->
  r3 1.[atkEndT3] 
  r3 2.[pb3.End] 
  r3 *. (atk.End; animation.Stop)

//only timers
r1(atkEndT1, pb1.End) ->
r1 1.[atkEndT1]
r1 2.[pb1.End] -> atkEndT2; r2(atkEndT2, pb2.End) -> 
 r2 1.[atkEndT2]
 r2 2.[pb2.End] -> atkEndT3; r3(atkEndT3, pb3.End) ->
  r3 1.[atkEndT3]
  r3 2.[pb3.End]

