<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../sdf.Core/Assets/Icon.ico</ApplicationIcon>
    <AssemblyName>sdf</AssemblyName>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SolsDawn.Core.Logic/SolsDawn.Core.Logic.csproj" />
    <ProjectReference Include="../SolsDawn.Gameplay/SolsDawn.Gameplay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <UpToDateCheckInput Include="../Content/Assets/**/*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="3.8.6.1" />
  </ItemGroup>
  <Import Project="../SolsDawn.Content/BuildContent.targets" />
</Project>
